{
  "openapi": "3.1.0",
  "info": {
    "title": "ForgeMesh ShoppingScout",
    "version": "0.1.0",
    "description": "Local development scaffold. Shipping estimates use supplied rules. Live catalog search and monitoring are planned; no payment required or accepted."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3478",
      "description": "Local development only; set PORT if occupied"
    }
  ],
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "get_capabilities",
        "summary": "Inspect availability and stable future capability IDs",
        "responses": {
          "200": {
            "description": "Capability catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "304": {
            "description": "Catalog unchanged"
          }
        }
      }
    },
    "/v1/shipping/compare": {
      "post": {
        "operationId": "compare_shipping_plans",
        "summary": "Compare estimated shipping and basket combinations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "currency",
                  "destination",
                  "items",
                  "fulfillment_groups"
                ],
                "properties": {
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$",
                    "description": "All input amounts use minor units of this currency; no currency conversion."
                  },
                  "destination": {
                    "type": "object",
                    "required": [
                      "country"
                    ],
                    "properties": {
                      "country": {
                        "type": "string",
                        "pattern": "^[A-Z]{2}$"
                      }
                    }
                  },
                  "constraints": {
                    "type": "object",
                    "properties": {
                      "max_shipments": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 6
                      },
                      "max_delivery_days": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 365
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "object",
                      "required": [
                        "item_id",
                        "quantity",
                        "offers"
                      ],
                      "properties": {
                        "item_id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
                        },
                        "quantity": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "offers": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "object",
                            "required": [
                              "offer_id",
                              "group_id",
                              "unit_price_minor"
                            ],
                            "properties": {
                              "offer_id": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
                              },
                              "group_id": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
                              },
                              "unit_price_minor": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 1000000000
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "fulfillment_groups": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "required": [
                        "group_id",
                        "merchant_id",
                        "rule_source",
                        "ship_to_countries",
                        "methods"
                      ],
                      "properties": {
                        "group_id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
                        },
                        "merchant_id": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
                        },
                        "rule_source": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "ship_to_countries": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "pattern": "^[A-Z]{2}$"
                          }
                        },
                        "methods": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 4,
                          "items": {
                            "type": "object",
                            "required": [
                              "method_id",
                              "base_minor",
                              "per_unit_minor",
                              "delivery_days_max"
                            ],
                            "properties": {
                              "method_id": {
                                "type": "string",
                                "pattern": "^[a-zA-Z0-9_.-]{1,80}$"
                              },
                              "base_minor": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 1000000000
                              },
                              "per_unit_minor": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 1000000000
                              },
                              "free_over_subtotal_minor": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 1000000000
                              },
                              "delivery_days_max": {
                                "type": [
                                  "integer",
                                  "null"
                                ],
                                "minimum": 0,
                                "maximum": 365
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete estimate set and recommendations; no_feasible_plan if constraints eliminate all options",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, destination not eligible, or combination limit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 64 KiB",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search": {
      "post": {
        "operationId": "search_products",
        "summary": "Search connected merchant catalogs. Catalog integration is not connected.",
        "x-status": "planned",
        "description": "Reserved operation. Always returns 501. Request contract is not finalized. Do not call this to subscribe; no state is stored.",
        "responses": {
          "501": {
            "description": "Not implemented; created=false, charged=false",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
